# If frontend is reverse-proxied with the API on the same domain, leave this as /api/v1.
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=AuRoom

# Temporary sandbox UX while Generation API is not implemented yet.
# Never enable this when you want to demonstrate real AI output.
VITE_DEMO_GENERATION=false

# Only used by Vite dev proxy.
VITE_DEV_API_TARGET=http://localhost:8000
