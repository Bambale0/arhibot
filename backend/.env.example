APP_ENV=local
APP_NAME=AuRoom API
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/app
REDIS_URL=redis://redis:6379/0
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=5
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Generate independent high-entropy secrets for non-local environments.
JWT_SECRET=local-only-change-me-access-secret-32-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=ai-architecture-platform
JWT_AUDIENCE=ai-architecture-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_TOKEN_SECRET=local-only-change-me-refresh-secret-32-bytes

# Telegram bot + Mini App. Business broadcasts are managed in web admin.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=https://app.example.com
TELEGRAM_INIT_DATA_TTL_SECONDS=3600

# NexusAPI credentials/infrastructure only.
# Primary/fallback models, prompts and model params are managed in web admin and stored in DB.
NEXUS_API_KEY=
NEXUS_BASE_URL=https://nexusapi.dev
NEXUS_TASK_TIMEOUT_SECONDS=180
NEXUS_POLL_INTERVAL_SECONDS=2
NEXUS_HTTP_CONNECT_TIMEOUT_SECONDS=5
NEXUS_HTTP_READ_TIMEOUT_SECONDS=30
NEXUS_RETRY_ATTEMPTS=3
NEXUS_CIRCUIT_FAILURE_THRESHOLD=5
NEXUS_CIRCUIT_RECOVERY_SECONDS=30

# YooKassa credentials/infrastructure only.
# Tariffs/prices/credits are managed in web admin and stored in DB.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_BASE_URL=https://api.yookassa.ru/v3
YOOKASSA_RETURN_URL=https://app.example.com/
YOOKASSA_HTTP_CONNECT_TIMEOUT_SECONDS=5
YOOKASSA_HTTP_READ_TIMEOUT_SECONDS=20
YOOKASSA_REQUEST_DEADLINE_SECONDS=30
YOOKASSA_RETRY_ATTEMPTS=3
YOOKASSA_CIRCUIT_FAILURE_THRESHOLD=5
YOOKASSA_CIRCUIT_RECOVERY_SECONDS=30

# Backend and generation worker write files here. Clients/provider receive short-lived signed URLs.
MEDIA_ROOT=/data/media
MEDIA_PUBLIC_BASE_URL=http://localhost:8000
# Dedicated HMAC key for short-lived media links; required and independent in production.
MEDIA_SIGNING_SECRET=
MEDIA_URL_TTL_SECONDS=900
MAX_IMAGE_SIZE_BYTES=20971520
MAX_MODEL_SIZE_BYTES=83886080
MAX_IMAGE_PIXELS=80000000

BOT_INTERNAL_API_BASE_URL=http://api:8000

# Container resource guardrails (Compose defaults shown; override only after measurement).
AUROOM_LOG_MAX_SIZE=10m
AUROOM_LOG_MAX_FILES=3
AUROOM_API_MEMORY_LIMIT=512m
AUROOM_API_CPU_LIMIT=0.75
AUROOM_API_PIDS_LIMIT=256
AUROOM_BOT_MEMORY_LIMIT=192m
AUROOM_BOT_CPU_LIMIT=0.25
AUROOM_BOT_PIDS_LIMIT=128
AUROOM_WORKER_MEMORY_LIMIT=1536m
AUROOM_WORKER_CPU_LIMIT=1.25
AUROOM_WORKER_PIDS_LIMIT=256
AUROOM_BROADCAST_WORKER_MEMORY_LIMIT=256m
AUROOM_BROADCAST_WORKER_CPU_LIMIT=0.35
AUROOM_BROADCAST_WORKER_PIDS_LIMIT=128
AUROOM_MAINTENANCE_MEMORY_LIMIT=384m
AUROOM_MAINTENANCE_CPU_LIMIT=0.35
AUROOM_MAINTENANCE_PIDS_LIMIT=128
AUROOM_FRONTEND_MEMORY_LIMIT=128m
AUROOM_FRONTEND_CPU_LIMIT=0.25
AUROOM_FRONTEND_PIDS_LIMIT=64
AUROOM_NGINX_MEMORY_LIMIT=128m
AUROOM_NGINX_CPU_LIMIT=0.25
AUROOM_NGINX_PIDS_LIMIT=64
AUROOM_POSTGRES_MEMORY_LIMIT=1024m
AUROOM_POSTGRES_CPU_LIMIT=1.00
AUROOM_REDIS_MEMORY_LIMIT=256m
AUROOM_REDIS_CPU_LIMIT=0.35
AUROOM_REDIS_PIDS_LIMIT=128
