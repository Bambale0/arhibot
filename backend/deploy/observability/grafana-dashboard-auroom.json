      },
      "datasource": {
        "type": "prometheus",
        "uid": "auroom-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(auroom_http_requests_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
