# Copy to <app_dir>/.backup.env with mode 0600.
# This file is read by host backup tooling only and is never injected into app containers.
#
# AUROOM_OFFSITE_BACKUP_REMOTE is an rclone remote/path, for example:
# auroom-backups:production/arhibot
AUROOM_OFFSITE_BACKUP_REMOTE=
# Public age recipient (age1...). The private identity must stay off the application host.
AUROOM_BACKUP_AGE_RECIPIENT=

# rclone (default) or telegram (private chats of active DB admins only).
AUROOM_BACKUP_TRANSPORT=telegram

# Optional private chat IDs, comma separated. Always intersected with current active DB admins.
# Leave empty to require delivery to every active administrator with a Telegram identity.
AUROOM_BACKUP_TELEGRAM_RECIPIENT_IDS=
